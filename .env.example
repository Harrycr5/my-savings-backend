# Aplicación
APP_NAME="Backend de ahorros personales y finanzas"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# PostgreSQL: credenciales de ejemplo para desarrollo local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/my_savings

# Frontend: lista JSON de orígenes permitidos, sin slash final.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Autenticación: generar una clave y colocarla en el .env
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pruebas: base exclusiva y descartable; debe terminar en _test.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/my_savings_test

# Correo de recuperación (configura los datos de tu proveedor SMTP).
# SMTP_HOST=smtp.tuproveedor.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu@gmail.com
SMTP_PASSWORD=codigo
SMTP_FROM_EMAIL=tu@gmail.com

SMTP_USE_TLS=false
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_START_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_COOLDOWN_SECONDS=60

#api reniec
link_reniec=https://api.scrall.net/v1/reniec/basico
reniec_api_key=tu_api_key
